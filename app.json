{
  "expo": {
    "name": "Daily Spark",
    "slug": "daily-spark",
    "scheme": "dailyspark",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14110F",
    "android": {
      "package": "com.dailyspark.app",
      "adaptiveIcon": {
        "backgroundColor": "#14110F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.READ_ELEVATION_GAINED",
        "android.permission.VIBRATE",
        "android.permission.health.READ_ACTIVITY_INTENSITY"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-background-task",
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "Daily Spark",
              "description": "Today's goal, progress and streak",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ],
      "expo-secure-store",
      "./plugins/withAbiSplits",
      "expo-calendar",
      "./plugins/withBackupRules"
    ],
    "owner": "thehighestprimenumbers-team",
    "extra": {
      "eas": {
        "projectId": "2c1f26a9-bbe0-45ea-85cf-3c1159569981"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2c1f26a9-bbe0-45ea-85cf-3c1159569981",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
